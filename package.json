{
  "name": "mp-tetris",
  "version": "1.0.0",
  "private": true,
  "description": "Online 1v1 multiplayer Tetris - lockstep netcode over WebSockets, three.js rendering",
  "type": "module",
  "scripts": {
    "dev:client": "vite client",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build client",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/src/index.js",
    "test:harness": "tsx test/harness.ts"
  },
  "dependencies": {
    "three": "^0.178.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/three": "^0.178.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
